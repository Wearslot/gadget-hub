<section>
  <div class="special-product grid-3">
    <div class="collection-category">
      <div class="row">
        <div class="col">
          <div class="collection-wrap">
            <ul class="product-view-ul">
              {{#iterate products}}
                <li class="pro-item-li" data-animate="animate__fadeIn">
                  <div class="single-product-wrap">
                    <div class="product-image">
                      <a
                        href="/product/{{current.slug}}"
                        class="pro-img"
                        data-slug="{{current.slug}}"
                      >
                        <img
                          src="{{current.image.main}}"
                          class="img-fluid img1 resp-img1"
                          alt="p-1"
                        />
                        <img
                          src="{{current.image.main}}"
                          class="img-fluid img2 resp-img2"
                          alt="p-2"
                        />
                      </a>

                      <div class="product-label pro-new-sale">
                        {{#ifCond current.discount ">" 0}}<span
                            class="product-label-title"
                          >{{current.discount}}</span>
                        {{/ifCond}}
                      </div>

                      <div class="product-action">
                        <a href="wishlist-product.html" class="add-to-wishlist">
                          <span class="product-icon"><i
                              class="feather-heart"
                            ></i></span>
                          <span class="tooltip-text">wishlist</span>
                        </a>

                        <a
                          href="#quickview-modal"
                          data-bs-toggle="modal"
                          class="quick-view"
                        >
                          <span class="product-icon"><i
                              class="feather-eye"
                            ></i></span>
                          <span class="tooltip-text">quickview</span>
                        </a>
                      </div>

                      <div class="product-cart">
                        <button type="button" class="add-to-cart">
                          <span class="product-icon">
                            <span class="product-bag-icon"><i
                                class="feather-shopping-bag"
                              ></i></span>
                            <span class="product-loader-icon"><i
                                class="feather-loader"
                              ></i></span>
                            <span class="product-check-icon"><i
                                class="feather-check"
                              ></i></span>
                          </span>
                        </button>
                      </div>
                    </div>
                    <div class="product-caption">
                      <div class="product-content">
                        <div class="product-title">
                          <h6>
                            <a
                              href="/product/{{current.slug}}"
                            >{{current.name}}</a>
                          </h6>
                        </div>
                        <div class="price-box">
                          <bdi><span class="new-price">{{{product_price
                                current
                              }}}</span></bdi>
                        </div>
                        <div class="product-ratting">
                          <span class="review-ratting">
                            <span class="review-star">
                              <i class="feather-star"></i>
                              <i class="feather-star"></i>
                              <i class="feather-star"></i>
                              <i class="feather-star"></i>
                              <i class="feather-star"></i>
                            </span>
                            <span class="review-caption">No reviews</span>
                          </span>
                        </div>
                        <div class="product-description">
                          <p>
                            Lorem Ipsum is simply dummy text of the printing and
                            typesetting industry It is a long established fact
                            that a will be distracted by the readable of at
                          </p>
                        </div>
                        <div class="product-action">
                          <a href="javascript:void(0)" class="add-to-cart">
                            <span class="product-icon">
                              <span class="product-bag-icon"><i
                                  class="feather-shopping-bag"
                                ></i></span>
                              <span class="product-loader-icon"><i
                                  class="feather-loader"
                                ></i></span>
                              <span class="product-check-icon"><i
                                  class="feather-check"
                                ></i></span>
                            </span>
                            <span class="tooltip-text">add to cart</span>
                          </a>
                          <a
                            href="#quickview-modal"
                            data-bs-toggle="modal"
                            class="quick-view"
                          >
                            <span class="product-icon"><i
                                class="feather-eye"
                              ></i></span>
                            <span class="tooltip-text">quickview</span>
                          </a>
                          <a
                            href="wishlist-product.html"
                            class="add-to-wishlist"
                          >
                            <span class="product-icon"><i
                                class="feather-heart"
                              ></i></span>
                            <span class="tooltip-text">wishlist</span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
              {{/iterate}}
            </ul>
          </div>

      <div class="paginatoin-area" data-animate="animate__fadeIn">
  <ul class="pagination-page-box" data-animate="animate__fadeIn">

    {{#if products.pagination.previous}}
      <li class="page-prev">
        <a href="?page={{products.pagination.previous}}&limit=5" class="theme-glink">
          <i class="fa-solid fa-angle-left"></i>
        </a>
      </li>
    {{/if}}

    {{#pagination products.pagination next=">" previous="<"}}
      <li class="number {{#ifCond products.pagination.page '==' page}}active{{/ifCond}}">
        <a class="{{#ifCond products.pagination.page '==' page}}theme-glink{{else}}gradient-text{{/ifCond}}"
           href="?page={{page}}&limit=5">
          {{page}}
        </a>
      </li>
    {{/pagination}}

    {{#if products.pagination.next}}
      <li class="page-next">
        <a href="?page={{products.pagination.next}}&limit=5" class="theme-glink">
          <i class="fa-solid fa-angle-right"></i>
        </a>
      </li>
    {{/if}}

  </ul>
</div>




        </div>
      </div>
    </div>
  </div>
</section>