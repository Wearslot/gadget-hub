<style>
  @media (max-width: 1000px) {
    .cart-wrap-info {
      flex-direction: column !important;
    }
    .cart-col-left,
    .cart-col-right {
      width: 100% !important;
    }
  }
</style>


<section class="cart-page section-ptb">
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="cart-page-wrap">
          <div class="cart-wrap-info" style="display: flex; flex-direction: row; width: 100%;">


              <!-- Cart Items Column -->
             <div class="cart-item-wrap cart-col-left" style="width: 70%;">

                <div class="cart-title" data-animate="animate__fadeIn">
                  <h6>My cart:</h6>
                  <span class="cart-count">
                    <span class="cart-counter">{{cart.items_count}}</span>
                    <span class="cart-item-title">Item</span>
                  </span>
                </div>

                {{{render "cart-items"}}}

                <div class="cart-buttons">
                  <a href="/cart/clear" class="btn-style2">Clear cart</a>
                </div>
              </div>

              <!-- Right Panel: Shipping + Summary -->
              <div class="cart-right-col cart-col-right" style="width: 30%;">
                <div class="cart-info-wrap" style="width: 100%;">
                  <!-- Shipping Calculator -->
                 <div class="cart-calculator cart-info" style="width: 100%;">
                    <h6>Shipping Info</h6>
                    <div class="culculate-shipping" id="shipping-calculator">
                      {{#form "shipping" 'class="taojaa-shipping-calculator"'}}
                        <ul>
                          <li class="field">
                            <label for="calc_shipping_country">Country</label>
                            {{{country_select_field 'id="calc_shipping_country" class="country_to_state country_select"' name="calc_shipping_country"}}}
                          </li>
                          <li class="field">
                            <label for="calc_shipping_state">State</label>
                            {{{state_select_field 'id="calc_shipping_state" class="state_select"' name="calc_shipping_state"}}}
                          </li>
                          <li class="field">
                            <label for="calc_shipping_city">City</label>
                            <input type="text" name="calc_shipping_city" id="calc_shipping_city" class="input-text" placeholder="City" value="{{shipping_address.city}}" />
                          </li>
                          <li class="field cpn-code">
                            <label for="calc_shipping_postcode">Postal/Zip Code</label>
                            <input type="text" name="calc_shipping_postcode" id="calc_shipping_postcode" class="input-text" placeholder="Zip/Postal Code" value="{{shipping_address.postal_code}}" />
                          </li>
                        </ul>
                        <div class="shipping-info text-right">
                          <button type="submit" name="calc_shipping" value="1" class="btn btn-style2">Calculate</button>
                        </div>
                      {{/form}}
                    </div>
                  </div>

                  <!-- Total & Checkout -->
                  <div class="cart-summary">
                    <table class="shop_table">
                      <tbody>
                        <tr class="order-total">
                          <th>Total</th>
                          <td data-title="Total">
                            <strong>
                              <span class="taojaa-Price-amount amount cart-total-amount">
                                {{{component "cart-total-amount"}}}
                              </span>
                            </strong>
                          </td>
                        </tr>
                      </tbody>
                    </table>

                    <div class="text-center cart-buttons">
                      <a href="{{{checkout}}}" class="btn-style2">
                        Proceed to Checkout
                      </a>
                    </div>
                  </div>

                </div>
              </div> <!-- /Right Col -->

  

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
