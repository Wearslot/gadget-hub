<div id="qodef-page-outer">
  <register-form>
    <main id="qodef-page-content" role="main">
      <div class="qodef-grid-inner clear">
        <div class="qodef-grid-item qodef-page-content-section qodef-col--12">
          <form id="register-form">
            <h2>Register</h2>

            <p class="form-group">
              <label for="userName">Name <span class="required">*</span></label>
              <input
                type="text"
                name="userName"
                id="userName"
                autocomplete="name"
              />
            </p>

            <p class="form-group">
              <label for="userEmail">Email Address
                <span class="required">*</span></label>
              <input
                type="email"
                name="userEmail"
                id="userEmail"
                autocomplete="email"
              />
            </p>

            <p class="form-group">
              <label for="password">Password
                <span class="required">*</span></label>
              <input
                type="password"
                name="password"
                id="password"
                autocomplete="new-password"
              />
            </p>

            <p class="form-group">
              <label for="confirm-password">Confirm Password
                <span class="required">*</span></label>
              <input
                type="password"
                name="confirm-password"
                id="confirm-password"
                autocomplete="new-password"
              />
            </p>

            <p>
              <button type="submit" id="submit">
                Sign Up
                {{{component "loader"}}}
              </button>

            </p>

            <p class="login-link">
              <a href="/account/login">Have an account? Login</a>
            </p>

            <p id="feedback"></p>
          </form>
        </div>
      </div>
    </main>
  </register-form>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () { const style =
  document.createElement("style"); style.textContent = ` #register-form {
  max-width: 480px; margin: 40px auto; padding: 30px; background-color: #fff;
  border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); font-family:
  system-ui, sans-serif; } #register-form h2 { text-align: center;
  margin-bottom: 24px; font-size: 24px; color: #333; } .form-group {
  margin-bottom: 20px; } .form-group label { display: block; margin-bottom: 6px;
  font-weight: 600; color: #444; } .form-group input { width: 100%; padding:
  10px 12px; font-size: 15px; border: 1px solid #ccc; border-radius: 4px;
  box-sizing: border-box; } #submit { width: 100%; padding: 12px;
  background-color: #0066cc; color: white; border: none; border-radius: 4px;
  font-size: 16px; cursor: pointer; transition: background-color 0.3s ease; }
  #submit:hover { background-color: #004999; } .login-link { text-align: center;
  margin-top: 15px; } .login-link a { color: #0066cc; text-decoration: none;
  font-size: 14px; } .login-link a:hover { text-decoration: underline; }
  #feedback { margin-top: 15px; border: 2px solid #00bcd4; background-color:
  #e0f7fa; color: #007c91; padding: 10px; border-radius: 4px; font-size: 14px;
  text-align: center; display: none; } `; document.head.appendChild(style); });
</script>