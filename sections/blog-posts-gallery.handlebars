<section class="blog-horizontal">
  <div class="blog-scroll">
    {{#iterate blogs}}
      {{#if (lt @index 4)}}
        <article class="blog-card">
          <a href="{{this.url}}" class="blog-link">
            <div class="blog-image-wrap">
              <img src="{{this.image}}" alt="{{this.title}}" class="blog-image" />
            </div>
            <h3 class="blog-title">{{this.title}}</h3>
          </a>
        </article>
      {{/if}}
    {{/iterate}}
  </div>
</section>

<style>
.blog-horizontal {
  padding: 1rem 0;
  overflow-x: auto;
}

.blog-scroll {
  display: flex;
  gap: 1rem;
}

.blog-card {
  flex: 0 0 auto;
  width: 250px;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.blog-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 12px rgba(0,0,0,0.15);
}

.blog-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.blog-image-wrap {
  width: 100%;
  height: 150px;
  overflow: hidden;
}

.blog-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.blog-title {
  padding: 0.75rem;
  font-size: 1rem;
  font-weight: 600;
  text-align: center;
}
</style>
