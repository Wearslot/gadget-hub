<!-- offer-text-section start -->
<div class="offer-text-area section-tb-padding">
    <div class="offer-text-wrap">
        <div class="offer-text">
            <ul>
                {{#widget name="offer_text"}}
                <li class="{{ widget.settings.text_class }}">
                    {{#each widget.settings.offers}}
                    <div class="offer-text-block">
                        <p>{{ this }}</p>
                    </div>
                    {{/each}}
                </li>
                {{/widget}}
            </ul>
        </div>
    </div>
</div>
<!-- offer-text-section end -->
