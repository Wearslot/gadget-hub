<!-- product-tab start -->
{{#if section.settings.show}}
<section class="product-tab-area section-ptb">
    <div class="container">
        <div class="collection-category">
            <div class="section-capture">
                <div class="section-title">
                    <h2 data-animate="animate__fadeIn" style="font-size: {{section.settings.heading_size}}px;">
                        {{section.settings.heading}}
                    </h2>
                </div>
            </div>

            {{#ifCond best_selling.data.length '>' 0}}
            <div class="collection-wrap">
                <div class="collection-slider swiper" id="new-product">
                    <div class="swiper-wrapper">
                        {{#iterate best_selling as="product" limit="8"}}
                        <div class="swiper-slide" data-animate="animate__fadeIn">
                            <div class="single-product-wrap">
                                <div class="product-image">
                                    <a href="/product/{{product.slug}}" class="pro-img">
                                        <img src="{{ product.image.main }}" class="img-fluid img1 resp-img1"
                                            alt="{{ product.name }}">
                                        {{#if product.image.second}}
                                        <img src="{{ product.image.second }}" class="img-fluid img2 resp-img2"
                                            alt="{{ product.name }}">
                                        {{/if}}
                                    </a>
                                    <div class="product-action">
                                        <a href="/wishlist" class="add-to-wishlist">
                                            <span class="product-icon"><i class="feather-heart"></i></span>
                                            <span class="tooltip-text">wishlist</span>
                                        </a>
                                        <a href="#quickview-modal" data-bs-toggle="modal" class="quick-view"
                                            data-product-id="{{product.id}}">
                                            <span class="product-icon"><i class="feather-eye"></i></span>
                                            <span class="tooltip-text">quickview</span>
                                        </a>
                                    </div>
                                    <div class="product-cart">
                                        <button type="button" class="add-to-cart" data-product-id="{{product.id}}">
                                            <span class="product-icon">
                                                <span class="product-bag-icon"><i
                                                        class="feather-shopping-bag"></i></span>
                                                <span class="product-loader-icon"><i class="feather-loader"></i></span>
                                                <span class="product-check-icon"><i class="feather-check"></i></span>
                                            </span>
                                        </button>
                                    </div>
                                    {{#ifCond product.discount ">" 0}}
                                    <span class="product-label">Sale</span>
                                    {{/ifCond}}
                                </div>
                                <div class="product-content">
                                    <div class="product-title">
                                        <h6><a href="/product/{{product.slug}}">{{ product.name }}</a></h6>
                                    </div>
                                    <div class="price-box">
                                        {{{ product_price product }}}
                                    </div>
                                    <div class="product-ratting">
                                        <span class="review-ratting" data-rate="{{ product.rating }}">
                                            <span class="review-star">
                                                <i class="feather-star"></i>
                                                <i class="feather-star"></i>
                                                <i class="feather-star"></i>
                                                <i class="feather-star"></i>
                                                <i class="feather-star"></i>
                                            </span>
                                            <span class="review-caption">
                                                {{#ifCond product.review_count '>' 0}}
                                                    {{ product.review_count }} reviews
                                                {{else}}
                                                    No reviews
                                                {{/ifCond}}
                                            </span>
                                        </span>
                                    </div>
                                    <div class="product-description">
                                        <p>{{ product.short_description }}</p>
                                    </div>
                                    <div class="product-action">
                                        <a href="/product/{{product.slug}}" class="add-to-cart">
                                            <span class="product-icon">
                                                <span class="product-bag-icon"><i
                                                        class="feather-shopping-bag"></i></span>
                                                <span class="product-loader-icon"><i class="feather-loader"></i></span>
                                                <span class="product-check-icon"><i class="feather-check"></i></span>
                                            </span>
                                            <span class="tooltip-text">
                                                {{#if product.has_variations}}select options{{else}}add to cart{{/if}}
                                            </span>
                                        </a>
                                        <a href="#quickview-modal" data-bs-toggle="modal" class="quick-view"
                                            data-product-id="{{product.id}}">
                                            <span class="product-icon"><i class="feather-eye"></i></span>
                                            <span class="tooltip-text">quickview</span>
                                        </a>
                                        <a href="/wishlist" class="add-to-wishlist">
                                            <span class="product-icon"><i class="feather-heart"></i></span>
                                            <span class="tooltip-text">wishlist</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/iterate}}
                    </div>
                    <div class="collection-button" data-animate="animate__fadeIn">
                        <a href="/collections" class="btn-style3">view more</a>
                    </div>
                </div>
                <div class="swiper-buttons">
                    <div class="swiper-buttons-wrap">
                        <button class="swiper-prev swiper-prev-new"><i class="feather-arrow-left"></i></button>
                        <button class="swiper-next swiper-next-new"><i class="feather-arrow-right"></i></button>
                    </div>
                </div>
                <div class="swiper-dots">
                    <div class="swiper-pagination swiper-pagination-new"></div>
                </div>
            </div>
            {{/ifCond}}

            {{#unless best_selling.data.length}}
            {{#ifCond featured_products.data.length '>' 0}}
            <div class="collection-wrap">
                <div class="collection-slider swiper" id="new-product">
                    <div class="swiper-wrapper">
                        {{#iterate featured_products as="product" limit="8"}}
                        <!-- Same .swiper-slide structure as above -->
                        {{/iterate}}
                    </div>
                    <div class="collection-button" data-animate="animate__fadeIn">
                        <a href="/collections" class="btn-style3">view more</a>
                    </div>
                </div>
                <div class="swiper-buttons">
                    <div class="swiper-buttons-wrap">
                        <button class="swiper-prev swiper-prev-new"><i class="feather-arrow-left"></i></button>
                        <button class="swiper-next swiper-next-new"><i class="feather-arrow-right"></i></button>
                    </div>
                </div>
                <div class="swiper-dots">
                    <div class="swiper-pagination swiper-pagination-new"></div>
                </div>
            </div>
            {{/ifCond}}
            {{/unless}}
        </div>
    </div>
</section>

<script type="text/javascript" src="{{asset_url}}/js/product-variant-switch.js"></script>
{{/if}}
<!-- product-tab end -->
