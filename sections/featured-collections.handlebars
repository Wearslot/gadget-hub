<!-- product-category start -->
{{#if section.settings.show}}
<section class="banner3 section-ptb">
    <div class="container">
        <div class="row">
            <div class="col">
                <ul class="banner-block">
                    {{#iterate collections as="collection" limit=4}}
                    <li>
                        <img src="{{ collection.image }}" class="img-fluid" alt="{{ collection.name }}">
                        <div class="banner-content banner-text-left banner-content-left">
                            <span class="banner-subtitle" data-animate="animate__fadeIn">{{ collection.subtitle }}</span>
                            <h2 data-animate="animate__fadeIn">{{ collection.name }}</h2>
                            <a data-animate="animate__fadeIn" href="/collection/{{ collection.slug }}"
                                class="button btn button-link btn-style3">Shop now</a>
                        </div>
                    </li>
                    {{/iterate}}
                </ul>
            </div>
        </div>

        {{#ifCond collections.data.length '>' 4}}
        <div class="row">
            <div class="col-lg-12 my-5">
                <div class="text-center">
                    <a class="text-dark" style="text-decoration: underline;" href="/collections">
                        View all collections
                    </a>
                </div>
            </div>
        </div>
        {{/ifCond}}

    </div>
</section>
{{/if}}
<!-- product-category end -->
