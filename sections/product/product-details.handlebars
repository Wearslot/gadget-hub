<!-- breadcrumb start -->
<script type="application/json">
  {{json product.variation_options}}
</script>

<section class="breadcrumb-area">
  <div class="container">
    <div class="col">
      <div class="row">
        <div class="breadcrumb-index">
          <!-- breadcrumb-list start -->
          <ul class="breadcrumb-ul">
            <li class="breadcrumb-li">
              <a class="breadcrumb-link" href="index1.html">Home</a>
            </li>
            <li class="breadcrumb-li">
              <span class="breadcrumb-text">{{product.name}}</span>
            </li>
          </ul>
          <!-- breadcrumb-list end -->
        </div>
      </div>
    </div>
  </div>
</section>
<!-- breadcrumb end -->

<!-- pro-detail-page start -->
<section class="product-details-page pro-style2 bg-color section-ptb">
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="pro-details-pos pro-details-left-pos">
          <!-- Product slider start -->
          <div
            class="product-detail-slider product-details-lr product-details product-details-sticky"
          >
            <a href="product-template.html" class="next-prev-product prev">
              <span>Prev</span>
            </a>
            <a href="product-template3.html" class="next-prev-product next">
              <span>Next</span>
            </a>
            <!-- Product slider start -->
            <div class="product-detail-img product-detail-img-right">
              <div class="product-img-top" data-animate="animate__fadeIn">
                <button class="full-view">
                  <i class="feather-maximize"></i>
                </button>

                <!-- Big slider start -->
                <div class="style2-slider-big slick-slider">
                  {{#iterate product.image.gallery}}
                    <div class="slick-slide">
                      <a href="{{current}}" class="product-single">
                        <img
                          src="{{current}}"
                          data-zoom="{{current}}"
                          class="img-fluid zoom"
                          alt="product-image"
                        />
                      </a>
                    </div>
                  {{/iterate}}
                      {{#if product.image.video}}
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#tabs-{{product.image.gallery.length}}"
                                role="tab">
                                <div class="product__thumb__pic set-bg" data-setbg="{{ product.image.main }}">
                                    <i class="fa fa-play"></i>
                                </div>
                            </a>
                        </li>
                        {{/if}}
                </div>
                <!-- Big slider end -->

              </div>

              <!-- Thumbnail slider start -->
              <div class="pro-slider" data-animate="animate__fadeIn">
                <div class="style2-slider-small pro-detail-slider">
                  {{#iterate product.image.gallery}}
                    <div class="slick-slide">
                      <a
                        href="javascript:void(0)"
                        class="product-single--thumbnail"
                      >
                        <img
                          src="{{current}}"
                          class="img-fluid"
                          alt="thumbnail"
                        />
                      </a>
                    </div>
                  {{/iterate}}
                </div>
              </div>
              <!-- Thumbnail slider end -->

            </div>
            <!-- Product slider end -->

          </div>
          <!-- peoduct detail start -->
          <div class="product-details-wrap product-details-lr product-details">
            <div class="product-details-info">
              <div class="pro-nprist">
                <div class="product-info" data-animate="animate__fadeIn">
                  <!-- product-ratting start -->
                  <div class="product-ratting">
                    <span class="pro-ratting">
                      <i class="fas fa-star"></i>
                      <i class="fas fa-star"></i>
                      <i class="fas fa-star"></i>
                      <i class="fas fa-star"></i>
                      <i class="fas fa-star-half-alt"></i>
                    </span>
                    <span class="spr-badge-caption">{{product.reviews.length}}</span>
                  </div>
                  <!-- product-ratting end -->
                </div>
                <div class="product-info" data-animate="animate__fadeIn">
                  <!-- product-title start -->
                  <div class="product-title">
                    <h2>{{product.name}}</h2>
                  </div>
                  <!-- product-title end -->
                </div>
                <div class="product-info" data-animate="animate__fadeIn">
                  <div class="pro-prlb pro-sale">
                    <div class="price-box">
                      <bdi><span class="new-price">{{{product_price product}}}</span></bdi>
                      {{#ifCond product.discount ">" 0}}
                      <span class="percent-count">{{product.discount}}</span>
                            {{/ifCond}}
                    </div>
                  </div>
                </div>
                <div class="product-info" data-animate="animate__fadeIn">
                  <div class="product-inventory">
                    {{!-- <div class="stock-inventory stock-more">
                      <p class="text-success">
                        Hurry up! only
                        <span class="available-stock bg-success">{{product.stock}}</span>
                        <span>products left in stock!</span>
                      </p>
                    </div> --}}
                    <div class="product-variant">
                      <h6>Availability:</h6>
                      <span class="stock-qty in-stock text-success">
                      <span class="button_text">
                                        {{#ifCond product.default_or_selected_variant.in_stock '!=' true}}
                                        Out of Stock
                                        {{else}}
                                        {{product.quantity}}
                                        {{/ifCond}}
                                    </span>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="product-info" data-animate="animate__fadeIn">
                  <div class="pro-detail-action">


<product-form>
  {{#form 'product' 'class="variations_form cart"' product=product}}

    {{#if product.has_only_default_variant}}
      {{!-- No variation selection needed --}}
    {{else}}
      <table class="variations" cellspacing="0" role="presentation">
        <tbody>
          {{#variations product}}
          <tr>
            <th class="label"><label for="{{type.name}}">{{type.name}}</label></th>
            <td class="value">
              <variant-field>
                <select id="{{type.name}}" variant="{{type.name}}" name="{{type.name}}" data-show_option_none="yes">
                  <option value>Choose an option</option>
                  {{#variantOptions this}}
                    <option value="{{name}}" {{#includes ../product.default_or_selected_options name}} selected="true" {{/includes}}>
                      {{name}}
                    </option>
                  {{/variantOptions}}
                </select>
              </variant-field>
            </td>
          </tr>
          {{/variations}}
        </tbody>
      </table>
    {{/if}}

    <div class="error d-none">
      <p class="error-message"></p>
    </div>

    <div class="single_variation_wrap">
      <div class="pro-detail-button">
        <div class="product-quantity-button">

          <div class="product-quantity-action">
            <h6>Quantity:</h6>
            <div class="product-quantity">
              <quantity-field>
                <div class="cart-plus-minus">
                  <button type="button" class="dec qtybutton minus"><i class="feather-minus"></i></button>
                  <input
                    type="text"
                    name="quantity"
                    value="1"
                    product-data="quantity"
                    data-step="1"
                    data-min="1"
                    {{#if product.default_or_selected_variant}}
                      data-max="{{product.default_or_selected_variant.quantity}}"
                    {{else}}
                      data-max="{{product.quantity}}"
                    {{/if}}
                  >
                  <button type="button" class="inc qtybutton plus"><i class="feather-plus"></i></button>
                </div>
              </quantity-field>
            </div>
          </div>

          <div class="product-action-buttons" style="display: flex; gap: 10px; align-items: center; margin-top: 20px;">
            {{#ifCond product.default_or_selected_variant.in_stock '!=' true}}
              <button type="submit" class="btn add-to-cart ajax-spin-cart disabled" style="padding: 10px" disabled>
            {{else}}
              <button type="submit" class="btn add-to-cart ajax-spin-cart"  style="padding: 10px">
            {{/ifCond}}
                <span class="cart-title">
                  {{#ifCond product.default_or_selected_variant.in_stock '!=' true}}
                    Out of Stock
                  {{else}}
                    Add to cart
                  {{/ifCond}}
                </span>
                {{{component "loader"}}}
              </button>
    
            {{!-- Wishlist Button --}}
            <button type="button" class="btn btn-outline-wishlist" aria-label="Add to Wishlist">
              <i class="feather-heart"></i>
            </button>
          </div>

          <input
            type="hidden"
            name="variant_id"
            class="variant_id"
            product-data="variant_id"
            value="{{product.default_or_selected_variant_id}}"
          />

        </div>
      </div>
    </div>

  {{/form}}
</product-form>


                  </div>
                </div>


                <div class="product-info" data-animate="animate__fadeIn">
                  <div class="form-group">
                    <a href="#deliver-modal" data-bs-toggle="modal">Delivery
                      &amp; return</a>
                  </div>
                </div>
                <div
                  class="modal fade deliver-modal"
                  id="deliver-modal"
                  tabindex="-1"
                  aria-hidden="true"
                >
                
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-body">
                        <button
                          type="button"
                          class="pop-close"
                          data-bs-dismiss="modal"
                          aria-label="Close"
                        >
                          <i class="feather-x"></i>
                        </button>
                        <div class="delivery-block">
                          <div class="space-block">
                            <h4>Delivery</h4>
                            <p>All orders shipped with UPS Express.</p>
                            <p>Always free shipping for orders over US $250.</p>
                            <p>
                              All orders are shipped with a UPS tracking number.
                            </p>
                          </div>
                          <div class="space-block">
                            <h4>Returns</h4>
                            <p>
                              Items returned within 14 days of their original
                              shipment date in same as new condition will be
                              eligible for a full refund or store credit.
                            </p>
                            <p>
                              Refunds will be charged back to the original form
                              of payment used for purchase.
                            </p>
                            <p>
                              Customer is responsible for shipping charges when
                              making returns and shipping/handling fees of
                              original purchase is non-refundable.
                            </p>
                            <p>All sale items are final purchases.</p>
                          </div>
                          <div class="space-block">
                            <h4>Help</h4>
                            <p>
                              Give us a shout if you have any other questions
                              and/or concerns.
                            </p>
                            <p>
                              Email:<a
                                href="{{store.email}}"
                              >{{store.email}}</a>
                            </p>
                            <p>
                              Phone:<a href="tel:{{store.phone}}">{{store.phone}}</a>
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>


           
