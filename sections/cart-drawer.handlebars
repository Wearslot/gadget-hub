<div class="cart-drawer" id="cart-drawer">
  <div>

    <!-- Drawer Header -->
    <div class="drawer-fixed-header">
      <div
        class="drawer-header"
        style="display: flex; justify-content: space-between; align-items: center;"
      >
        <h6
          class="drawer-header-title"
          style="font-size: 24px; font-weight: bold;"
        >Cart</h6>
        <div class="drawer-close">
          <button type="button" class="drawer-close-btn" aria-label="Close">
            <span class="drawer-close-icon" style="font-size: 24px;">
              <i class="feather-x"></i>
            </span>
          </button>
        </div>
      </div>

    </div>

    <div class="drawer-contents">
      {{#if cart.items_count}}
        <!-- Filled Cart wrapped in form -->
        <form method="post" action="javascript:void(0)">
          <div class="drawer-inner cart-fill">
            <div class="drawer-scrollable">
              <ul class="cart-items">
                {{{render "cart-items-drawer"}}}
              </ul>
              <div class="drawer-notes">
                <label for="cartnote">Order note</label>
                <textarea
                  name="note"
                  class="cart-notes"
                  id="cartnote"
                ></textarea>
              </div>
            </div>
            <div class="drawer-footer">
              <div class="drawer-total">
                <span class="drawer-subtotal">Subtotal</span>
                <h6 class="drawer-totalprice">
                  <span class="total-cart">
                    {{{component "cart-total-amount"}}}
                  </span>
                </h6>
              </div>
              <div class="drawer-ship-text">
                <span>Shipping, taxes, and discount codes calculated at checkout</span>
              </div>
              <div class="drawer-cart-checkout">
                <div class="wt-content">
                  <div class="wt-content-btn">
                    <div class="wt-btn wt-full-btn">
                      <a href="/cart" class="btn-style4">View cart</a>
                    </div>
                    <div class="wt-btn wt-full-btn">
                      <a href="/checkout" class="btn-style2">Checkout</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </form>

      {{else}}

        <!-- Empty Cart (outside form) -->
        <div class="drawer-cart-empty cart-unfill">
          <div
            class="drawer-scrollable"
            style="display: flex; justify-content: center; align-items: center; height: 100%;"
          >
            <h5 style="text-align: center;">Your cart is currently empty</h5>
          </div>
        </div>

      {{/if}}
    </div>

  </div>
</div>