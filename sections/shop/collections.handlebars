<!-- collection-list left start -->
<section class="main-content-wrap bg-color shop-page section-ptb">
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="pro-grli-wrapper left-side-wrap">
          <div class="pro-grli-wrap product-grid">
            <div class="collection-img-wrap">
              <h6 class="st-title" data-animate="animate__fadeIn">
                Collection list left (23)
              </h6>

              <!-- collection info start -->
              <div class="collection-info">
                <div class="collection-image" data-animate="animate__fadeIn">
                  <img
                    src="image/home1/collection/collection-banner.jpg"
                    class="img-fluid"
                    alt="sall-banner"
                  />
                </div>
              </div>
              <!-- collection info end -->
            </div>

            <!-- Latest-product start -->
            <div class="special-product grid-1">
              <div class="collection-category">
                <div class="row">
                  <div class="col">
                    <div class="collection-wrap">
                      <ul class="product-view-ul">
                        {{#iterate collections}}
                        <li class="pro-item-li" data-animate="animate__fadeIn">
                          <div class="single-product-wrap">
                            <div class="product-image">
                              <a
                                href="/product/{{current.slug}}"
                                class="pro-img"
                              >
                                <img
                                  src="{{current.image.main}}"
                                  class="img-fluid img1 resp-img1"
                                  alt="{{current.name}}"
                                />
                                {{#if current.image.secondary}}
                                <img
                                  src="{{current.image.secondary}}"
                                  class="img-fluid img2 resp-img2"
                                  alt="{{current.name}}"
                                />
                                {{/if}}
                              </a>

                              {{#ifCond current.discount ">" 0}}
                              <div class="product-label pro-new-sale">
                                <span class="product-label-title">
                                  {{current.discount}}%
                                </span>
                              </div>
                              {{/ifCond}}

                              <div class="product-action">
                                <a
                                  href="wishlist-product.html"
                                  class="add-to-wishlist"
                                >
                                  <span class="product-icon">
                                    <i class="feather-heart"></i>
                                  </span>
                                  <span class="tooltip-text">wishlist</span>
                                </a>
                                <a
                                  href="#quickview-modal"
                                  data-bs-toggle="modal"
                                  class="quick-view"
                                  data-slug="{{current.slug}}"
                                >
                                  <span class="product-icon">
                                    <i class="feather-eye"></i>
                                  </span>
                                  <span class="tooltip-text">quickview</span>
                                </a>
                              </div>

                              <div class="product-cart">
                                <button
                                  type="button"
                                  class="add-to-cart"
                                  data-product-id="{{current.id}}"
                                >
                                  <span class="product-icon">
                                    <span class="product-bag-icon">
                                      <i class="feather-shopping-bag"></i>
                                    </span>
                                    <span class="product-loader-icon">
                                      <i class="feather-loader"></i>
                                    </span>
                                    <span class="product-check-icon">
                                      <i class="feather-check"></i>
                                    </span>
                                  </span>
                                </button>
                              </div>
                            </div>

                            <div class="product-caption">
                              <div class="product-content">
                                <div class="product-title">
                                  <h6>
                                    <a href="/product/{{current.slug}}">
                                      {{current.name}}
                                    </a>
                                  </h6>
                                </div>

                                <div class="price-box">
                                  <span class="new-price">
                                    {{{product_price current}}}
                                  </span>
                                  {{#ifCond current.discount ">" 0}}
                                  <span class="old-price">
                                    {{current.old_price}}
                                  </span>
                                  {{/ifCond}}
                                </div>

                                {{#if current.reviews}}
                                <div class="product-ratting">
                                  <span class="review-ratting">
                                    <span class="review-star">
                                      {{#times 5}}
                                      <i class="feather-star"></i>
                                      {{/times}}
                                    </span>
                                    <span class="review-caption">
                                      {{current.reviews}} reviews
                                    </span>
                                  </span>
                                </div>
                                {{else}}
                                <div class="product-ratting">
                                  <span class="review-ratting">
                                    <span class="review-star">
                                      <i class="feather-star"></i>
                                      <i class="feather-star"></i>
                                      <i class="feather-star"></i>
                                      <i class="feather-star"></i>
                                      <i class="feather-star"></i>
                                    </span>
                                    <span class="review-caption">
                                      No reviews
                                    </span>
                                  </span>
                                </div>
                                {{/if}}

                                {{#if current.description}}
                                <div class="product-description">
                                  <p>{{current.description}}</p>
                                </div>
                                {{/if}}

                                <div class="product-action">
                                  <a
                                    href="javascript:void(0)"
                                    class="add-to-cart"
                                    data-product-id="{{current.id}}"
                                  >
                                    <span class="product-icon">
                                      <span class="product-bag-icon">
                                        <i class="feather-shopping-bag"></i>
                                      </span>
                                      <span class="product-loader-icon">
                                        <i class="feather-loader"></i>
                                      </span>
                                      <span class="product-check-icon">
                                        <i class="feather-check"></i>
                                      </span>
                                    </span>
                                    <span class="tooltip-text">add to cart</span>
                                  </a>
                                  <a
                                    href="#quickview-modal"
                                    data-bs-toggle="modal"
                                    class="quick-view"
                                    data-slug="{{current.slug}}"
                                  >
                                    <span class="product-icon">
                                      <i class="feather-eye"></i>
                                    </span>
                                    <span class="tooltip-text">quickview</span>
                                  </a>
                                  <a
                                    href="wishlist-product.html"
                                    class="add-to-wishlist"
                                  >
                                    <span class="product-icon">
                                      <i class="feather-heart"></i>
                                    </span>
                                    <span class="tooltip-text">wishlist</span>
                                  </a>
                                </div>
                              </div>
                            </div>
                          </div>
                        </li>
                        {{/iterate}}
                      </ul>
                    </div>

                    <div class="paginatoin-area" data-animate="animate__fadeIn">
                      <ul class="pagination-page-box">
                        <li class="number active">
                          <a href="javascript:void(0)" class="theme-glink">1</a>
                        </li>
                        <li class="number">
                          <a href="javascript:void(0)" class="gradient-text">2</a>
                        </li>
                        <li class="page-next">
                          <a href="javascript:void(0)" class="theme-glink">
                            <i class="fa-solid fa-angle-right"></i>
                          </a>
                        </li>
                      </ul>
                    </div>

                  </div>
                </div>
              </div>
            </div>
            <!-- Latest-product end -->

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- collection-list left end -->
