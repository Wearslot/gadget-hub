<!-- category-slider start -->
{{#if section.settings.show}}
<section class="slider-category section-pt">
    <div class="section-capture">
        <div class="section-title">
            <h2 data-animate="animate__fadeIn">Popular Categories</h2>
        </div>
    </div>
    <div class="container">
        <div class="cat-category">
            <div class="cat-wrap">
                <div class="cat-slider owl-carousel owl-theme" id="cat-slider">
                    {{#iterate collections as="collection" limit=6}}
                    <div class="item">
                        <div class="cat-block">
                            <a href="/collection/{{ collection.slug }}">
                                <div class="text-block">
                                    {{#if collection.discount}}
                                    <span class="offer-count">{{ collection.discount }}% Off</span>
                                    {{/if}}
                                    <h6 class="cat-title" data-animate="animate__fadeIn">{{ collection.name }}</h6>
                                    <p class="pro-count" data-animate="animate__fadeIn">
                                        {{ collection.product_count }}+ Items
                                    </p>
                                    <span class="shop-btn" data-animate="animate__fadeIn">
                                        <i class="feather-arrow-right"></i>
                                    </span>
                                </div>
                                <div class="cat-img">
                                    <img src="{{ collection.image }}" class="img-fluid" alt="{{ collection.name }}">
                                </div>
                            </a>
                        </div>
                    </div>
                    {{/iterate}}
                </div>
            </div>
        </div>

        {{#ifCond collections.data.length '>' 6}}
        <div class="row">
            <div class="col-lg-12 my-5">
                <div class="text-center">
                    <a class="text-dark" style="text-decoration: underline;" href="/collections">
                        View all collections
                    </a>
                </div>
            </div>
        </div>
        {{/ifCond}}
    </div>
</section>
{{/if}}
<!-- category-slider end -->
